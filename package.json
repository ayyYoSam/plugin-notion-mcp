{
  "name": "plugin-mcp",
  "version": "1.0.0",
  "description": "One command to install and configure the Notion MCP automatically.",
  "type": "module",
  "bin": {
    "plugin-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayyYoSam/plugin-notion-mcp.git"
  },
  "keywords": [
    "mcp",
    "notion",
    "model-context-protocol",
    "cli",
    "typescript"
  ],
  "author": "Sam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ayyYoSam/plugin-notion-mcp/issues"
  },
  "homepage": "https://github.com/ayyYoSam/plugin-notion-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "keytar": "^7.9.0",
    "open": "^11.0.2",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
