{
  "name": "plugin-notion-mcp",
  "version": "0.1.0",
  "description": "One command to install and configure the Notion MCP automatically.",
  "type": "module",

  "bin": {
    "plugin": "./dist/index.js"
  },

  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],

  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest",
    "prepare": "npm run build"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayyYoSam/plugin-notion-mcp.git"
  },

  "keywords": [
    "mcp",
    "notion",
    "model-context-protocol",
    "cli",
    "typescript"
  ],

  "author": "Sam",
  "license": "MIT",

  "bugs": {
    "url": "https://github.com/ayyYoSam/plugin-notion-mcp/issues"
  },

  "homepage": "https://github.com/ayyYoSam/plugin-notion-mcp#readme",

  "engines": {
    "node": ">=22"
  },

  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "ora": "^9.4.1",
    "zod": "^4.5.4"
  },

  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}