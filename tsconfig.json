{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",

    "types": ["node", "vitest/globals"],

    "sourceMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],

  "exclude": [
    "dist",
    "node_modules"
  ]
}